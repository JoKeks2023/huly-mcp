# ─── Authentication (choose ONE option) ──────────────────────────────────────
# One Huly account can use several workspaces. No workspace is configured here:
# the server discovers every workspace the account can access, and each tool
# takes a `workspace` argument (see the list_workspaces tool).

# Option A — Email + password (works once you have set a password on your Huly account)
HULY_EMAIL=your-email@example.com
HULY_PASSWORD=your-password

# Option B — Token auth (for SSO / Google / GitHub accounts without a password)
# Run the interactive setup wizard to get a token via email OTP:
#   npm run setup
# HULY_TOKEN=your-token-here

# ─── Self-hosted Huly ────────────────────────────────────────────────────────
# Account service (login + workspace discovery). Default: Huly Cloud.
# HULY_ACCOUNTS_URL=https://account.huly.app
# Front service (document/description content + file uploads). Not used for discovery.
# HULY_FRONT_URL=https://your-huly-instance.com
# Running next to Huly (same Docker network)? Internal addresses keep traffic on the
# machine, e.g. with nginx reachable as "huly". (An internal HULY_FRONT_URL works too,
# but invite links would then show the internal address.)
# HULY_ACCOUNTS_URL=http://huly/_accounts
# HULY_TRANSACTOR_URL=ws://huly/_transactor

# ─── Docker image only ───────────────────────────────────────────────────────
# Host names clients use to reach the container (reverse proxy / public name),
# comma-separated. Without it only localhost is accepted (421 "Invalid Host header").
# MCP_ALLOWED_HOSTS=huly-mcp.example.com,huly-mcp.example.com:443
# Docker: the server's own HTTP endpoint (/mcp) instead of mcp-proxy — persistent sessions,
# one Huly login per person via X-Huly-Token or X-Huly-Email/X-Huly-Password headers.
# MCP_TRANSPORT=http
# Bearer token clients must send; required to use the HULY_* login above over HTTP.
# MCP_AUTH_TOKEN=
# Several fixed accounts on one server, each at /<name>/mcp with its own bearer token (see README):
# MCP_PROFILES_FILE=/run/secrets/huly-profiles.json
# "Log in with Huly" (OAuth): people add <MCP_PUBLIC_URL>/mcp in their AI app and log in in the browser.
# MCP_OAUTH_SECRET=   # openssl rand -hex 32
# MCP_PUBLIC_URL=https://huly-mcp.example.com

# ─── Single workspace (optional) ─────────────────────────────────────────────
# Pin this server to one workspace (slug, name or id). Tools then take no
# workspace argument, which saves ~20% of the tool-list tokens. Leave unset to
# use all workspaces of the account.
# HULY_WORKSPACE=your-workspace-slug

# ─── Toolsets (optional) ─────────────────────────────────────────────────────
# Which tool groups to expose (each tool costs context tokens in every session).
# Default: agent,tracker,documents,chat,contacts,inbox,activity,planner,generic
# Also available: tracker-admin, calendar, github, generic-write, collaboration, cards,
# fields, drive, templates, testing, products — or "all".
# HULY_TOOLSETS=all
# Start with HULY_TOOLSETS and let Claude load more toolsets on demand (enable_toolsets).
# Needs a client that handles tools/list_changed.
# HULY_DYNAMIC_TOOLSETS=1
# Tool annotations (title, read-only / destructive) for clients that use them; ~16% larger tool list.
# HULY_ANNOTATIONS=1

# Connect at start-up so the first call is fast (default on); 0 = connect on the first call.
# HULY_PREWARM=0

# ─── Guard rails for agents (optional) ───────────────────────────────────────
# Only allow changes in these projects (reads are never blocked):
# HULY_WRITE_PROJECTS=TSK,WEB
# Append every change as one JSON line to this file:
# HULY_AUDIT_LOG=/var/log/huly-mcp-audit.jsonl
# Default agent name for claim_issue:
# HULY_AGENT_NAME=claude
# Ask before deletes and other risky tools: auto (ask when the client can), strict, off
# HULY_CONFIRM=auto

# ─── Local files (optional) ──────────────────────────────────────────────────
# upload_file(localPath) / download_file(savePath) only work inside this directory:
# HULY_FILE_ROOT=/home/me/huly-files
# How often subscribed huly:// resources are checked for changes (ms):
# HULY_SUBSCRIBE_POLL_MS=30000
