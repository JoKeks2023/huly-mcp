# ─── Authentication (choose ONE option) ──────────────────────────────────────
# One Huly account can use several workspaces. No workspace is configured here:
# the server discovers every workspace the account can access, and each tool
# takes a `workspace` argument (see the list_workspaces tool).

# Option A — Email + password (works once you have set a password on your Huly account)
HULY_EMAIL=your-email@example.com
HULY_PASSWORD=your-password

# Option B — Token auth (for SSO / Google / GitHub accounts without a password)
# Run the interactive setup wizard to get a token via email OTP:
#   npm run setup
# HULY_TOKEN=your-token-here

# ─── Self-hosted Huly ────────────────────────────────────────────────────────
# Account service (login + workspace discovery). Default: Huly Cloud.
# HULY_ACCOUNTS_URL=https://account.huly.app
# Front service (document/description content + file uploads). Not used for discovery.
# HULY_FRONT_URL=https://your-huly-instance.com

# ─── Legacy (optional) ───────────────────────────────────────────────────────
# Restrict this server to a single workspace (slug, name or id). Leave unset to
# use all workspaces of the account.
# HULY_WORKSPACE=your-workspace-slug
