{
  "name": "huly-mcp-selfhost",
  "version": "3.6.2",
  "description": "MCP server for Huly (self-hosted and Huly Cloud): 227 tools for Claude and other AI agents — issues, epics, documents, chat, planner, test management — with toolsets for low token use, an agent workflow and a Claude Code plugin.",
  "keywords": [
    "huly",
    "huly-selfhost",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "claude",
    "claude-code",
    "claude-desktop",
    "ai-agents",
    "project-management",
    "issue-tracker",
    "self-hosted"
  ],
  "homepage": "https://jokeks2023.github.io/huly-mcp/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JoKeks2023/huly-mcp.git"
  },
  "mcpName": "io.github.JoKeks2023/huly-mcp-selfhost",
  "license": "EPL-2.0",
  "author": "Joris Conrad (https://github.com/JoKeks2023)",
  "contributors": [
    "SaiVaraprasad Medapati (original huly-mcp-sdk: https://github.com/varaprasadreddy9676/huly-mcp)"
  ],
  "bin": {
    "huly-mcp": "dist/index.js",
    "huly-mcp-selfhost": "dist/index.js",
    "huly-mcp-setup": "dist/setup.js"
  },
  "files": [
    "dist/",
    ".env.example",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node --max-old-space-size=4096 node_modules/typescript/bin/tsc --noEmit && node scripts/build.js",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "setup": "node scripts/setup.js",
    "prepublishOnly": "npm run build",
    "test": "node --import tsx --test test/*.test.ts",
    "mcpb": "node scripts/mcpb.js",
    "plugin:bundle": "node scripts/plugin-bundle.js"
  },
  "dependencies": {},
  "devDependencies": {
    "@hcengineering/account-client": "^0.7.0",
    "@hcengineering/attachment": "0.7.0",
    "@hcengineering/chunter": "^0.7.0",
    "@hcengineering/contact": "^0.7.0",
    "@hcengineering/core": "^0.7.0",
    "@hcengineering/document": "^0.7.0",
    "@hcengineering/platform": "^0.7.0",
    "@hcengineering/rank": "^0.7.0",
    "@hcengineering/server-client": "^0.7.0",
    "@hcengineering/tags": "^0.7.0",
    "@hcengineering/task": "^0.7.0",
    "@hcengineering/tracker": "^0.7.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.0",
    "esbuild": "^0.28.2",
    "express": "^5.3.0",
    "tsx": "^4.19.0",
    "typescript": "^7.0.2",
    "ws": "^8.22.1",
    "zod": "^4.6.7"
  },
  "overrides": {
    "dompurify": "^3.4.17",
    "uuid": "^11.1.1"
  },
  "bugs": {
    "url": "https://github.com/JoKeks2023/huly-mcp/issues"
  }
}
